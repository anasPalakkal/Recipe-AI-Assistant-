{
  "name": "recipeai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @recipeai/api dev",
    "dev:web": "pnpm --filter @recipeai/web dev"
  },
  "devDependencies": {
  "typescript": "^5.6.0",
  "eslint": "^9.12.0",
  "@eslint/js": "^9.12.0",
  "typescript-eslint": "^8.8.0"
}
}
