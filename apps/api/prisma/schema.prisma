generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 0/1 scope: auth (User) plus the recipe domain (Recipe, Ingredient,
// InstructionStep, AiGeneration), added in Phase 2. Phase 6 adds ApiKey and
// UsageRecord for the public API. Conversation and Message remain deferred
// (architecture.md §4).
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String?
  provider          String   @default("credentials")
  // providerAccountId is null for credentials users. Postgres treats
  // multiple NULLs in a unique constraint as non-colliding, so many
  // credentials rows can coexist under this constraint safely — do not
  // "fix" this by making providerAccountId non-nullable.
  providerAccountId String?
  // Null until the user completes OTP verification (credentials signup)
  // or signs in via Google (set at creation). Derive "isVerified" from
  // this field everywhere — do not add a parallel boolean.
  emailVerifiedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recipes       Recipe[]
  aiGenerations AiGeneration[]
  apiKeys       ApiKey[]

  conversations Conversation[]

  @@unique([provider, providerAccountId])
}

enum RecipeSource {
  USER
  AI
}

enum ImageSource {
  PEXELS
  AI_GENERATED
  NONE
}

model Recipe {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  servings        Int?
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  source          RecipeSource      @default(USER)
  ingredients     Ingredient[]
  steps           InstructionStep[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  chatMessages Message[]

  imageUrl              String?
  imageThumbnailUrl     String?
  imageSource           ImageSource @default(NONE)
  imageAttributionName  String?
  imageAttributionUrl   String?


  // Supports both "list my recipes" and cursor pagination ordered by
  // recency, scoped to the owner in the same index.
  @@index([userId, createdAt])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float?
  unit     String?
  order    Int

  @@index([recipeId, order])
}

model InstructionStep {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  content  String
  order    Int

  @@index([recipeId, order])
}

enum GenerationStatus {
  SUCCESS
  FAILED
}

// Audit log of every AI generation call, independent of whether the user
// saved the result as a Recipe. Never exposed as part of the Recipe domain.
model AiGeneration {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String
  rawResponse Json
  status      GenerationStatus
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
}

// A user may hold multiple concurrent active keys (default cap enforced at
// the service layer, not here) to support rotation without downtime: issue
// a new key, roll it out, revoke the old one — never a window with zero
// valid key. rateLimitPerMinute and monthlyQuota are per-key data, not
// global constants, so limits can be tuned per customer without a deploy.
model ApiKey {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  // First ~10 chars of the raw key (e.g. "rk_live_ab"), shown in the
  // dashboard so a user can tell keys apart. Not secret on its own.
  keyPrefix          String
  // SHA-256 hash of the full raw key. The raw key itself is never stored
  // and is shown to the user exactly once, at creation.
  keyHash            String    @unique
  rateLimitPerMinute Int       @default(20)
  monthlyQuota       Int       @default(300)
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  usageRecords UsageRecord[]

  // Active-key lookups and "list my keys" both filter/sort by owner.
  @@index([userId])
}

// One row per public /v1 request, independent of whether the underlying
// generation succeeded — mirrors AiGeneration's role for internal traffic.
// Never exposed outside usage/analytics endpoints.
model UsageRecord {
  id         String   @id @default(cuid())
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint   String
  statusCode Int
  createdAt  DateTime @default(now())

  // Supports both "usage for this key" and time-bucketed usage queries
  // (e.g. this month's request count for a dashboard chart) in one index.
  @@index([apiKeyId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  pinned    Boolean   @default(false)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Chat history list: pinned conversations first, then most recently
  // active, scoped to owner — single index covers the full sort.
  @@index([userId, pinned, updatedAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageResponseType {
  RECIPE
  FOOD_INFO
  REFUSED
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
// User turns: the prompt text. Assistant turns: populated for FOOD_INFO
// (the answer text) and REFUSED (the refusal message) responses; null for
// RECIPE responses, which store their data in recipeDraft instead.
content        String?
  // Assistant turns only. Same validated shape as RecipeDraft, stored as
  // JSON since it's read-only display data here, not a queryable relation.
  recipeDraft    Json?
 // Set once the user successfully saves this turn as a Recipe. A second
 // save attempt is rejected (ConflictError, 409) rather than treated as a
 // no-op — this signals the "already saved" state explicitly rather than
 // silently swallowing it.
savedRecipeId  String?
  savedRecipe    Recipe?      @relation(fields: [savedRecipeId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())


  imageUrl              String?
  imageThumbnailUrl     String?
  imageSource           ImageSource @default(NONE)
  imageAttributionName  String?
  imageAttributionUrl   String?


  responseType MessageResponseType? // set only on ASSISTANT messages; null for USER


  @@index([conversationId, createdAt])
}