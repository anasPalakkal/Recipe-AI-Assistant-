generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 0/1 scope: auth (User) plus the recipe domain (Recipe, Ingredient,
// InstructionStep, AiGeneration), added in Phase 2. ApiKey, Conversation,
// Message, and UsageRecord remain deferred to later phases (architecture.md §4).
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String?
  provider          String   @default("credentials")
  // providerAccountId is null for credentials users. Postgres treats
  // multiple NULLs in a unique constraint as non-colliding, so many
  // credentials rows can coexist under this constraint safely — do not
  // "fix" this by making providerAccountId non-nullable.
  providerAccountId String?
  // Null until the user completes OTP verification (credentials signup)
  // or signs in via Google (set at creation). Derive "isVerified" from
  // this field everywhere — do not add a parallel boolean.
  emailVerifiedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recipes       Recipe[]
  aiGenerations AiGeneration[]

  @@unique([provider, providerAccountId])
}

enum RecipeSource {
  USER
  AI
}

model Recipe {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  servings        Int?
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  source          RecipeSource      @default(USER)
  ingredients     Ingredient[]
  steps           InstructionStep[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Supports both "list my recipes" and cursor pagination ordered by
  // recency, scoped to the owner in the same index.
  @@index([userId, createdAt])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float?
  unit     String?
  order    Int

  @@index([recipeId, order])
}

model InstructionStep {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  content  String
  order    Int

  @@index([recipeId, order])
}

enum GenerationStatus {
  SUCCESS
  FAILED
}

// Audit log of every AI generation call, independent of whether the user
// saved the result as a Recipe. Never exposed as part of the Recipe domain.
model AiGeneration {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String
  rawResponse Json
  status      GenerationStatus
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
}